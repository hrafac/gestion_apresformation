# Configuration PostgreSQL
POSTGRES_DB=marsa_eval
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Configuration Spring Boot
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/marsa_eval
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Configuration JWT
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# Configuration Email
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_TRUST=smtp.gmail.com

# Configuration Python Analyse
PYTHONPATH=/app
PYTHONUNBUFFERED=1
DEBUG=0

# Configuration Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# Configuration PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@marsamaroc.ma
PGADMIN_DEFAULT_PASSWORD=admin123

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
ANALYSE_PORT=8000
POSTGRES_PORT=5432
PGADMIN_PORT=5050
